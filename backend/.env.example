# ==============================================================================
# YoloHome Backend Configuration
# ==============================================================================

# Database Configuration:
DATABASE_URL=sqlite:///yolohome.db

# Security Key cho Token xác thực (JWT)
SECRET_KEY=yolohome-secret-key-2026-change-in-production

# Adafruit IO Credentials (lấy từ https://io.adafruit.com -> My Key)
ADAFRUIT_IO_USERNAME=your_username_here
ADAFRUIT_IO_KEY=your_aio_key_here

# (Tùy chọn) Adafruit IO MQTT Broker settings
ADAFRUIT_IO_HOST=io.adafruit.com
ADAFRUIT_IO_PORT=8883
ADAFRUIT_IO_TLS=1

